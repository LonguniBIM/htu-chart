# TopstepX Futures Terminal Configuration Example
# Copy to .env and fill in local values. NEVER commit .env or real secrets.

# Application environment: "development" or "production"
APP_ENV=development

# Explicit bind interface (NEVER use wildcard unspecified IP or *)
APP_BIND_HOST=127.0.0.1
APP_PORT=8000

# Comma-separated or JSON list of allowed HTTP Host headers (DNS rebinding guard)
APP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Comma-separated or JSON list of allowed browser Origin headers
APP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Single-user Argon2id password hash (generate locally with argon2-cffi PasswordHasher().hash(...))
APP_PASSWORD_HASH=

# Random session secret (leave empty to generate ephemeral per-process secret, or set 32+ random chars)
APP_SESSION_SECRET=

# Set true when terminating TLS/HTTPS (e.g., Tailscale Serve HTTPS)
APP_COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400

# Optional path to built SPA static files (defaults to <repo>/frontend/dist when present)
FRONTEND_DIST_DIR=

# TopstepX Read-Only Market Data credentials (used server-side only; NEVER exposed to browser)
TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=
TOPSTEPX_LIVE=false
TOPSTEPX_BASE_URL=https://api.topstepx.com
TOPSTEPX_RTC_URL=wss://rtc.topstepx.com/hubs/market

# API Key rotation tracking (YYYY-MM-DD)
TOPSTEPX_KEY_UPDATED_AT=
KEY_ROTATION_DAYS=30
KEY_ROTATION_ENFORCE=false

# Local data directory for Parquet cache and SQLite metadata
DATA_DIR=./data

# Paginated history backfill limits (F04)
HISTORY_PAGE_LIMIT=5000
HISTORY_MAX_PAGES=50
HISTORY_BACKFILL_TIMEOUT_SEC=120.0

# SignalR / WebSocket live feed resilience (F03, R06)
SIGNALR_ENABLED=true
SIGNALR_RECOVERY_QUEUE_MAXSIZE=4096
SIGNALR_RECOVERY_TIMEOUT_SEC=30.0
SIGNALR_RECONNECT_INITIAL_DELAY_SEC=2.0
SIGNALR_RECONNECT_MAX_DELAY_SEC=60.0
SIGNALR_PING_INTERVAL_SEC=15.0
SIGNALR_HEARTBEAT_TIMEOUT_SEC=45.0
WS_CLIENT_QUEUE_MAXSIZE=64
WS_SEND_TIMEOUT_SEC=5.0
WS_MAX_CLIENTS=32

# Telegram Alert Outbox & Dispatcher (F07)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
ALERT_TTL_SECONDS=90
ALERT_MAX_RETRIES=3
ALERT_RETRY_BACKOFF_SEC=2.0,5.0,15.0
ALERT_DISPATCH_POLL_INTERVAL_SEC=1.0
ALERT_SCANNER_ENABLED=true
ALERT_DISPATCHER_ENABLED=true

# Isolated Python Backtest Worker Bounds & Kill-Switch (R02, F08)
BACKTEST_ENABLED=true
BACKTEST_MAX_QUEUE_DEPTH=3
BACKTEST_MAX_BARS=50000
BACKTEST_MAX_DATE_RANGE_DAYS=365
BACKTEST_TIMEOUT_SEC=30.0
BACKTEST_MAX_RESULT_BYTES=5000000
BACKTEST_MAX_JOBS_RETAINED=64
