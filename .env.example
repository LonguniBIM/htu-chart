# TopstepX Futures Terminal Configuration Example
# Copy to .env and fill in local values. NEVER commit .env or real secrets.

# Application environment: "development" or "production"
APP_ENV=development

# Explicit bind interface (NEVER use 0.0.0.0, ::, or *)
APP_BIND_HOST=127.0.0.1
APP_PORT=8000

# Comma-separated or JSON list of allowed HTTP Host headers (DNS rebinding guard)
APP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Comma-separated or JSON list of allowed browser Origin headers
APP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Single-user Argon2id password hash (generate locally with argon2-cffi PasswordHasher().hash(...))
APP_PASSWORD_HASH=

# Random session secret (leave empty to generate ephemeral per-process secret, or set 32+ random chars)
APP_SESSION_SECRET=

# Set true when terminating TLS/HTTPS in front of the app
APP_COOKIE_SECURE=false

# TopstepX Read-Only Market Data credentials (used server-side only)
TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=
TOPSTEPX_LIVE=false

# API Key rotation tracking (YYYY-MM-DD)
TOPSTEPX_KEY_UPDATED_AT=
KEY_ROTATION_DAYS=30
KEY_ROTATION_ENFORCE=false

# Local data directory for Parquet cache and SQLite metadata
DATA_DIR=./data

# Paginated history backfill limits (F04)
HISTORY_PAGE_LIMIT=5000
HISTORY_MAX_PAGES=50
HISTORY_BACKFILL_TIMEOUT_SEC=120.0
