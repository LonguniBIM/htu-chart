{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexRoomReviewOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision_sha",
    "lens",
    "verdict",
    "summary",
    "findings",
    "test_quality_issues",
    "unverified_areas"
  ],
  "properties": {
    "revision_sha": {
      "type": "string",
      "description": "Exact 40-character git commit SHA reviewed."
    },
    "lens": {
      "type": "string",
      "enum": [
        "correctness_and_tests",
        "security_and_invariants"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVE",
        "CHANGES_REQUESTED",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "file",
          "line_start",
          "line_end",
          "title",
          "behavior_affected",
          "trigger_condition",
          "evidence",
          "verification_method",
          "plan_ref"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "category": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line_start": {
            "type": "integer"
          },
          "line_end": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "behavior_affected": {
            "type": "string"
          },
          "trigger_condition": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "verification_method": {
            "type": "string"
          },
          "plan_ref": {
            "type": "string"
          }
        }
      }
    },
    "test_quality_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unverified_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
